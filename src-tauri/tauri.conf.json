{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "System Maintenance Toolkit",
  "version": "2.0.0",
  "identifier": "com.pcmaintenance.toolkit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "System Maintenance Toolkit",
        "width": 1060,
        "height": 740,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../src/*.ps1": "scripts/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
